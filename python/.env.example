# 아무 키도 없이 동작합니다 (kfes·팝업 수집 → 규칙 정제 → src/data/events.json).
# 아래 값은 전부 선택이며, 채우면 해당 기능이 자동으로 켜집니다.

# 저장소: auto(Supabase 키 있으면 supabase, 없으면 json) | json | supabase
STORE=auto
# 정제기: auto(ANTHROPIC_API_KEY 있으면 claude, 없으면 rules) | rules | claude
PARSER=auto

# 선택(무료 키): 한국관광공사 TourAPI (data.go.kr)
TOUR_API_SERVICE_KEY=

# 선택(유료): Anthropic Claude 정제
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 선택: Supabase 저장 (파이프라인 쓰기는 service role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 서울 열린데이터광장 문화행사 API (--sources seoul)
SEOUL_API_KEY=
# 선택: 네이버 검색 API (--sources web; 없으면 DuckDuckGo 대체)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택: 카카오 로컬 API (좌표 없는 행사 지오코딩)
KAKAO_REST_API_KEY=
# 선택: 실패/부분 실패 알림
SLACK_WEBHOOK_URL=

# 선택
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MAX_PAGES=10
TOUR_API_MAX_DETAIL_CALLS=300
CLAUDE_BATCH_SIZE=3
RAW_DATA_DIR=data/raw
PARSED_DATA_DIR=data/parsed
DRY_RUN=false
